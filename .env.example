# Origin list relevant only when running frontend on a separate host.
VI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local DB path. Do not store real investor or confidential submissions in this demo.
VI_DATA_DIR=./backend/data

# auto uses real LangGraph if installed; falls back explicitly to local-sequential.
VI_WORKFLOW_ENGINE=auto
# Set to 1 ONLY with valid keys and approved synthetic data / no confidential documents:
VI_LANGFUSE_ENABLED=0
# LANGFUSE_PUBLIC_KEY=...
# LANGFUSE_SECRET_KEY=...
# LANGFUSE_HOST=https://cloud.langfuse.com
